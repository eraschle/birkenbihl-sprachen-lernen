# ============================================================================
# Birkenbihl Provider Configuration
# ============================================================================
#
# Copy this file to settings.yaml and add your API keys.
# settings.yaml is in .gitignore - keep your keys private.
#
# Each provider needs:
#   - name: Display name (used in UI and CLI)
#   - provider_type: one of
#       openai             OpenAI
#       anthropic          Anthropic Claude
#       google             Google Gemini
#       openai-compatible  any service with an OpenAI-style API (needs api_url):
#                          Ollama, LM Studio, OpenRouter, DeepSeek, Groq, Mistral, ...
#   - model: Model name as the provider spells it
#   - api_key: Your API key (any non-empty value for local servers like Ollama)
#   - api_url: Only for openai-compatible
#   - is_default: Mark one provider as default
#
# ============================================================================

providers:
  - name: Claude Sonnet
    provider_type: anthropic
    model: claude-sonnet-4-5
    api_key: sk-ant-your-anthropic-api-key-here
    is_default: true

  # - name: OpenAI
  #   provider_type: openai
  #   model: gpt-4o
  #   api_key: sk-your-openai-api-key-here
  #   is_default: false

  # - name: Gemini Flash
  #   provider_type: google
  #   model: gemini-2.5-flash
  #   api_key: your-google-api-key-here
  #   is_default: false

  # - name: Ollama (local)
  #   provider_type: openai-compatible
  #   model: llama3.1
  #   api_key: ollama
  #   api_url: http://localhost:11434/v1
  #   is_default: false

  # - name: OpenRouter
  #   provider_type: openai-compatible
  #   model: meta-llama/llama-3.3-70b-instruct
  #   api_key: sk-or-your-openrouter-key-here
  #   api_url: https://openrouter.ai/api/v1
  #   is_default: false

  # - name: DeepSeek
  #   provider_type: openai-compatible
  #   model: deepseek-chat
  #   api_key: sk-your-deepseek-api-key-here
  #   api_url: https://api.deepseek.com/v1
  #   is_default: false

target_language: de

# Pronunciation (listening phase): the original text is spoken and can be saved as audio file.
#   provider: piper       local and free; downloads one voice per language once (~60 MB)
#             elevenlabs  prefer ElevenLabs (cloud, natural voices, needs elevenlabs_api_key)
# Languages without a Piper voice (e.g. ja, ko, el, he) use ElevenLabs if a key is set.
audio:
  provider: piper
  elevenlabs_api_key: ""
  elevenlabs_voice_id: ""   # empty: default voice
  speech_speed: 1.0         # 0.7 (very slow) to 1.0 (normal); also selectable in the translation tab

# ============================================================================
# API keys
#   - Anthropic: https://console.anthropic.com/settings/keys
#   - OpenAI: https://platform.openai.com/api-keys
#   - Google Gemini: https://aistudio.google.com/app/apikey
#   - Ollama: local installation, no key needed (https://ollama.com)
#   - ElevenLabs (audio): https://elevenlabs.io/app/settings/api-keys
#
# Keys can also come from environment variables (.env):
#   api_key: ${ANTHROPIC_API_KEY}
# ============================================================================
